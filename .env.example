# Multi-Agent Content Writer — environment variables
# Copy this file to .env and fill in your keys.

# Required — powers the router and all three agents.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional — enables Tavily-backed research/search tools.
# Without it, the tools fall back to OpenAI's hosted web_search,
# which needs no extra key. Get one free at https://tavily.com
TAVILY_API_KEY=
